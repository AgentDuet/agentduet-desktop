<ContentDialog x:Class="Recorder.ConnectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 CloseButtonText="Cancel" RequestedTheme="Dark">
 <StackPanel Spacing="16">
  <StackPanel x:Name="BrowserPage" Spacing="16">
   <Image Source="ms-appx:///logo.png" Width="60" Height="60" AutomationProperties.Name="AgentDuet"/>
   <TextBlock Text="Sign in to AgentDuet" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}"/>
   <Button x:Name="BrowserButton" Content="Sign in" HorizontalAlignment="Stretch" Click="OpenBrowser" Style="{ThemeResource AccentButtonStyle}"/>
   <HyperlinkButton Content="Use a connector and API key" HorizontalAlignment="Center" Click="Manual"/>
  </StackPanel>
  <StackPanel x:Name="ManualPage" Spacing="12" Visibility="Collapsed">
   <TextBlock Text="Use a connector and API key" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}"/>
   <TextBlock Text="Enter the connector UUID and API key for your AgentDuet line." TextWrapping="Wrap" HorizontalAlignment="Center"/>
   <TextBox x:Name="Uuid" Header="Connector UUID" PlaceholderText="00000000-0000-0000-0000-000000000000" IsSpellCheckEnabled="False" TextChanged="UuidChanged"/>
   <PasswordBox x:Name="Key" Header="API key" PlaceholderText="Paste your API key" PasswordChanged="KeyChanged"/>
  </StackPanel>
  <TextBlock x:Name="Feedback" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <Grid x:Name="ManualFooter" Margin="0,10,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <HyperlinkButton x:Name="BackButton" Content="Back" Click="GoBack"/>
   <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel"/>
   <Button Grid.Column="2" x:Name="ConnectButton" Content="Connect" Click="Save" Style="{ThemeResource AccentButtonStyle}"/>
  </Grid>
 </StackPanel>
</ContentDialog>
