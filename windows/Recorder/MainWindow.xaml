<Window x:Class="Recorder.MainWindow" Title="AgentDuet Recorder"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24" RowSpacing="12" SizeChanged="OnResize">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Heading" Text="AgentDuet Recorder" Style="{ThemeResource TitleTextBlockStyle}"/>
   <Button x:Name="Navigation" Grid.Column="1" Visibility="Collapsed" Click="Navigate">Settings</Button>
  </Grid>
  <InfoBar Grid.Row="1" x:Name="Notice" IsClosable="True"/>
  <ScrollViewer x:Name="Setup" Grid.Row="2" Visibility="Collapsed">
   <StackPanel MaxWidth="600" HorizontalAlignment="Left" Spacing="14" Padding="0,4,12,24">
    <StackPanel x:Name="Terms" Spacing="12">
     <TextBlock Text="Review the terms" Style="{ThemeResource SubtitleTextBlockStyle}"/>
     <Expander Header="Terms of Use"><TextBlock x:Name="TermsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
     <Expander Header="Privacy Policy"><TextBlock x:Name="PrivacyText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
     <Button Click="Agree" Style="{ThemeResource AccentButtonStyle}">I agree</Button>
    </StackPanel>
    <StackPanel x:Name="Account" Spacing="10">
     <TextBlock Text="Phone line" Style="{ThemeResource SubtitleTextBlockStyle}"/>
     <TextBlock x:Name="Identity" TextWrapping="Wrap"/>
     <Button x:Name="Browser" Click="SignIn">Sign in with browser</Button>
     <Button x:Name="SignOutButton" Click="SignOut">Sign out</Button>
     <Expander x:Name="Manual" Header="Use a connector UUID and API key">
      <StackPanel Spacing="10" MinWidth="220">
       <TextBox x:Name="Uuid" Header="Connector UUID" IsSpellCheckEnabled="False"/>
       <PasswordBox x:Name="Key" Header="API key"/>
       <Button Click="Connect">Connect phone line</Button>
      </StackPanel>
     </Expander>
    </StackPanel>
    <StackPanel x:Name="Storage" Spacing="10">
     <TextBlock Text="Recordings folder" Style="{ThemeResource SubtitleTextBlockStyle}"/>
     <TextBlock x:Name="Folder" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Click="ChooseFolder">Choose folder</Button><Button Click="OpenFolder">Open folder</Button>
     </StackPanel>
     <CheckBox x:Name="Login" Content="Start at login" Click="ChangeLogin"/>
     <Button x:Name="FinishButton" Click="Finish" Style="{ThemeResource AccentButtonStyle}">Finish setup</Button>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="Library" Grid.Row="2" Visibility="Collapsed" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock x:Name="Connection" Style="{ThemeResource CaptionTextBlockStyle}"/>
   <Grid Grid.Row="1" ColumnSpacing="16" x:Name="Panes">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="260"/><ColumnDefinition x:Name="DetailColumn"/></Grid.ColumnDefinitions>
    <Grid x:Name="ListPane" RowSpacing="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="People" Style="{ThemeResource SubtitleTextBlockStyle}"/>
     <ListView Grid.Row="1" x:Name="People" AutomationProperties.Name="People" DisplayMemberPath="Name" SelectionChanged="SelectPerson" IsItemClickEnabled="True" ItemClick="OpenPerson"/>
     <TextBlock x:Name="Empty" Grid.Row="1" Text="No calls recorded yet." TextWrapping="Wrap" IsHitTestVisible="False"/>
    </Grid>
    <Grid x:Name="Details" Grid.Column="1" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Button x:Name="Back" Click="GoBack">Back to people</Button>
     <TextBlock x:Name="PersonName" Grid.Row="1" TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}"/>
     <ListView Grid.Row="2" x:Name="Calls" AutomationProperties.Name="Calls" SelectionMode="None">
      <ListView.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,6" Spacing="4">
        <TextBlock Text="{Binding Date}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
        <Button Content="Play recording" Visibility="{Binding PlayVisibility}" Click="Play"/>
       </StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
     <StackPanel Grid.Row="3" x:Name="Playback" Visibility="Collapsed" Spacing="4">
      <TextBlock x:Name="Playing" TextWrapping="Wrap"/>
      <MediaPlayerElement x:Name="Player" Height="64" AreTransportControlsEnabled="True"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
