<Window x:Class="Recorder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" SizeChanged="OnResize">
  <Grid.Resources>
   <Style TargetType="TextBlock" x:Key="Secondary">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
   </Style>
   <Style TargetType="Border" x:Key="SettingsCard">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid x:Name="Header" Padding="16,0,8,0" Height="48" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="SettingsBack" Visibility="Collapsed" Click="Navigate" AutomationProperties.Name="Back to recordings" ToolTipService.ToolTip="Back" Style="{StaticResource SubtleButtonStyle}"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button>
   <Grid x:Name="DragArea" Grid.Column="1" Background="Transparent">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <TextBlock Text="AgentDuet Recorder" FontWeight="SemiBold"/>
     <Ellipse x:Name="StatusDot" Width="7" Height="7" Visibility="Collapsed"/>
     <TextBlock x:Name="Connection" Style="{StaticResource Secondary}"/>
    </StackPanel>
   </Grid>
   <Button x:Name="Navigation" Grid.Column="2" Margin="0,0,12,0" Visibility="Collapsed" Click="Navigate" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings" Style="{StaticResource SubtleButtonStyle}"><Button.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Quit Recorder" Click="Quit"/></MenuFlyout></Button.ContextFlyout><FontIcon Glyph="&#xE713;" FontSize="17"/></Button>
  </Grid>
  <InfoBar Grid.Row="1" x:Name="Notice" IsClosable="True"/>
  <ContentControl Grid.Row="2" x:Name="Setup" Margin="12,4,12,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed">
   <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListView Width="185" x:Name="Sections" AutomationProperties.Name="Settings sections" Visibility="Collapsed" SelectionChanged="ChangeSection" SelectedIndex="0">
    <ListViewItem Tag="Account" AutomationProperties.Name="Account"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontSize="16" Glyph="&#xE77B;"/><TextBlock Text="Account"/></StackPanel></ListViewItem>
    <ListViewItem Tag="Recording" AutomationProperties.Name="Recording"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontSize="16" Glyph="&#xE717;"/><TextBlock Text="Recording"/></StackPanel></ListViewItem>
    <ListViewItem Tag="Permissions" AutomationProperties.Name="Permissions"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontSize="16" Glyph="&#xEA18;"/><TextBlock Text="Permissions"/></StackPanel></ListViewItem>
    <ListViewItem Tag="About" AutomationProperties.Name="About"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon FontSize="16" Glyph="&#xE946;"/><TextBlock Text="About"/></StackPanel></ListViewItem>
   </ListView>
   <Grid Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="10" Padding="20">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel HorizontalAlignment="Stretch" Spacing="12">
     <ComboBox x:Name="CompactSections" AutomationProperties.Name="Settings section" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="ChangeCompactSection">
      <x:String>Account</x:String><x:String>Recording</x:String><x:String>Permissions</x:String><x:String>About</x:String>
     </ComboBox>
     <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}"/>
     <StackPanel x:Name="Terms" Spacing="12">
      <Expander Header="Terms of Use" HorizontalAlignment="Stretch"><TextBlock x:Name="TermsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
      <Expander Header="Privacy Policy" HorizontalAlignment="Stretch"><TextBlock x:Name="PrivacyText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
      <Button Click="Agree" Style="{StaticResource AccentButtonStyle}">I agree</Button>
     </StackPanel>
     <StackPanel x:Name="Account" Spacing="12">
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <Grid Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Name" VerticalAlignment="Center"/>
        <Grid Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OwnerName" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Content="Edit…" Click="EditOwner" AutomationProperties.Name="Edit account name"/></StackPanel></Grid>
       </Grid>
       <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
       <Grid x:Name="NumberRow" Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Your number" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="Number" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
      </StackPanel></Border>
      <TextBlock Text="AgentDuet Connection" FontWeight="SemiBold" Margin="0,6,0,0"/>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <Grid Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Status" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Ellipse x:Name="AccountDot" Width="7" Height="7"/><TextBlock x:Name="AccountStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
       </Grid>
       <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
       <Grid x:Name="KeyRow" Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="API key" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><TextBlock x:Name="KeyHint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Content="Change…" Click="ChangeKey" /></StackPanel>
       </Grid>
       <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
       <Grid x:Name="SignInRow" Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Account" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Content="Sign in…" Click="SignIn" AutomationProperties.Name="Sign in to account"/></StackPanel>
       </Grid>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="Storage" Spacing="12">
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <Grid Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Folder" VerticalAlignment="Center"/>
        <Grid Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Folder" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Content="Choose…" Click="ChooseFolder" AutomationProperties.Name="Choose folder"/><Button Content="Open in Explorer" Click="OpenFolder" /></StackPanel></Grid>
       </Grid>
      </StackPanel></Border>
      <TextBlock x:Name="FolderWarning" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
     </StackPanel>
     <StackPanel x:Name="Permissions" Spacing="12">
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <Grid Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Recordings folder access" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><TextBlock x:Name="FolderAccess" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><HyperlinkButton x:Name="FixFolder" Content="Fix…" Click="ChooseFolder"/></StackPanel>
       </Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <Grid Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Start when I log in" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><ToggleSwitch x:Name="Login" AutomationProperties.Name="Start when I log in" OffContent="" OnContent="" MinWidth="0" Toggled="ChangeLogin"/></StackPanel>
       </Grid>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="About" Spacing="12">
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <Grid Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Version" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="Version" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
       </Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <Grid Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Logs" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Content="Export logs…" Click="ExportLogs" /></StackPanel>
       </Grid>
       <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
       <Grid Padding="14,9" MinHeight="50" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Agreed to" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8"><Button Content="Terms of Use" Click="ShowTerms" /><Button Content="Privacy Policy" Click="ShowPrivacy" /></StackPanel>
       </Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <Grid Padding="14,9" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Updates"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource Secondary}" FontSize="12"/></StackPanel>
        <Button x:Name="UpdateButton" Grid.Column="1" Content="Check now" Click="CheckUpdates" Style="{StaticResource AccentButtonStyle}"/>
       </Grid>
      </StackPanel></Border>
     </StackPanel>
     <Button x:Name="FinishButton" Click="Finish" Style="{StaticResource AccentButtonStyle}">Finish setup</Button>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  </ContentControl>
  <Grid x:Name="Library" Grid.Row="2" Visibility="Collapsed" Margin="8,2,10,10">
   <Grid ColumnSpacing="12" x:Name="Panes">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="232"/><ColumnDefinition x:Name="DetailColumn"/></Grid.ColumnDefinitions>
    <Grid x:Name="ListPane" RowSpacing="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="4,4,4,0"><TextBox x:Name="Search" Padding="32,5,8,5" PlaceholderText="Search people" AutomationProperties.Name="Search people" TextChanged="SearchChanged" CornerRadius="6"/>
      <FontIcon Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/></Grid>
     <ListView Grid.Row="1" x:Name="People" AutomationProperties.Name="People" SelectionChanged="SelectPerson" IsItemClickEnabled="True" ItemClick="OpenPerson">
      <ListView.ItemTemplate><DataTemplate>
       <Grid ColumnSpacing="10" Padding="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <PersonPicture Initials="{Binding Initials}" Width="36" Height="36"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Grid>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
     <TextBlock x:Name="Empty" Grid.Row="1" Margin="12" Style="{StaticResource Secondary}" IsHitTestVisible="False"/>
    </Grid>
    <Grid x:Name="Details" Grid.Column="1" Padding="16" RowSpacing="12" CornerRadius="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel Spacing="6">
      <Button x:Name="Back" Click="GoBack" Style="{StaticResource SubtleButtonStyle}">Back to people</Button>
      <PersonPicture x:Name="Avatar" Width="64" Height="64" Margin="0,4,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
       <TextBlock x:Name="PersonName" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <Button Click="EditPerson" AutomationProperties.Name="Edit person name" ToolTipService.ToolTip="Edit person name" Style="{StaticResource SubtleButtonStyle}"><FontIcon Glyph="&#xE70F;" FontSize="13"/></Button>
      </StackPanel>
      <TextBlock x:Name="PersonInfo" HorizontalAlignment="Center" Style="{StaticResource Secondary}"/>
     </StackPanel>
     <TextBlock x:Name="NoCalls" Grid.Row="1" Text="No calls yet" HorizontalAlignment="Center" Style="{StaticResource Secondary}" Visibility="Collapsed"/>
     <ListView Grid.Row="1" x:Name="Calls" MaxWidth="720" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Calls" SelectionMode="None">
      <ListView.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,6">
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="PlayButton" AutomationProperties.Name="Play recording" ToolTipService.ToolTip="Play recording" Visibility="{Binding PlayVisibility}" Click="Play" Width="32" Height="32" CornerRadius="16" Padding="0"><FontIcon FontSize="13" Glyph="&#xE768;"/></Button>
         <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Date}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Visibility="{Binding StatusVisibility}" Style="{StaticResource Secondary}" FontStyle="Italic"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

       </StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
